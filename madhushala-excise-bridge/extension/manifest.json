{
  "manifest_version": 3,
  "name": "Madhushala Excise Capture",
  "version": "1.4.3",
  "description": "State-aware Madhushala Excise portal login and WB Prepare Indent capture.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://report.madhushalasoftware.com/*",
        "https://excise.wb.gov.in/*",
        "https://integrations.madhushalasoftware.com/*",
        "https://excise.connect.snapkey.in/*",
        "http://13.232.52.191/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge_content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "Excise Capture",
    "default_popup": "popup.html"
  }
}
