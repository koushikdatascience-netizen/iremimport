{
  "manifest_version": 3,
  "name": "Madhushala Excise Capture",
  "version": "1.1.0",
  "description": "Capture typed Prepare Indent rows and send them to Madhushala Excise Import.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "windows"],
  "host_permissions": [
    "https://excise.wb.gov.in/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://excise.wb.gov.in/*",
        "https://excise.connect.snapkey.in/*",
        "http://13.232.52.191/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge_content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Excise Capture",
    "default_popup": "popup.html"
  }
}
