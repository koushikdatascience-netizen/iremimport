LOCAL_HOST=0.0.0.0
LOCAL_PORT=8091
HEADLESS=false

MADHUSHALA_BASE_URL=https://reportapi.madhushalasoftware.com
MADHUSHALA_SHOP_CODE=hedu_test3
MADHUSHALA_COMPANY_CODE=2
MADHUSHALA_BILL_TYPE=AI
MADHUSHALA_TOKEN=
ALLOW_RUNTIME_TOKEN_CONFIG=false

EXCISE_USERNAME=
EXCISE_PASSWORD=
EXCISE_LOGIN_URL=https://excise.wb.gov.in/WBSBCL/Bevco/NIC/UserLogin/Login.aspx

BROWSER_PROFILE_DIR=/app/data/browser_profile
CAPTURES_DIR=/app/data/captures
MAPPINGS_DIR=/app/data/mappings

CORS_ORIGINS=http://localhost:8091,http://127.0.0.1:8091,https://excise.connect.snapkey.in

DISPLAY=:99
VNC_GEOMETRY=1366x768x24
VNC_PORT=5900
NOVNC_PORT=6080

# Madhushala pooled HTTP client
MADHUSHALA_CONNECT_TIMEOUT_SECONDS=5
MADHUSHALA_READ_TIMEOUT_SECONDS=30
MADHUSHALA_WRITE_TIMEOUT_SECONDS=30
MADHUSHALA_POOL_TIMEOUT_SECONDS=5
MADHUSHALA_MAX_CONNECTIONS=100
MADHUSHALA_MAX_KEEPALIVE_CONNECTIONS=20
MADHUSHALA_MAX_CONCURRENCY=20
MADHUSHALA_ITEM_FETCH_CONCURRENCY=8
MADHUSHALA_READ_RETRY_ATTEMPTS=3
MADHUSHALA_RETRY_BASE_DELAY_SECONDS=0.15
MADHUSHALA_CIRCUIT_FAILURE_THRESHOLD=5
MADHUSHALA_CIRCUIT_OPEN_SECONDS=20

# Optional shared Redis cache; blank uses the in-process TTL cache
REDIS_URL=
MADHUSHALA_CACHE_PREFIX=madhushala
MADHUSHALA_MASTER_CACHE_TTL_SECONDS=3600
MADHUSHALA_USER_CACHE_TTL_SECONDS=1800
MADHUSHALA_SCHEME_CACHE_TTL_SECONDS=900
MADHUSHALA_CONFIG_CACHE_TTL_SECONDS=10800
MADHUSHALA_ITEM_CACHE_TTL_SECONDS=21600
