LOCAL_HOST=0.0.0.0
LOCAL_PORT=8091
HEADLESS=false
APP_ENV=development
APP_BASE_URL=https://integrations.madhushalasoftware.com/excise-import
DATABASE_PATH=/app/data/bridge.db

MADHUSHALA_BASE_URL=https://reportapi.madhushalasoftware.com
MADHUSHALA_SHOP_CODE=hedu_test3
MADHUSHALA_COMPANY_CODE=2
MADHUSHALA_BILL_TYPE=AI
MADHUSHALA_TOKEN=
MADHUSHALA_SERVICE_TOKEN=
ALLOW_RUNTIME_TOKEN_CONFIG=false

# Shared Madhushala HTTP pool
MADHUSHALA_CONNECT_TIMEOUT_SECONDS=5
MADHUSHALA_READ_TIMEOUT_SECONDS=30
MADHUSHALA_WRITE_TIMEOUT_SECONDS=30
MADHUSHALA_POOL_TIMEOUT_SECONDS=5
MADHUSHALA_MAX_CONNECTIONS=100
MADHUSHALA_MAX_KEEPALIVE_CONNECTIONS=20
MADHUSHALA_GET_RETRIES=2
MADHUSHALA_ITEM_FETCH_CONCURRENCY=8

# Optional shared cache. Leave blank for current single-instance deployment;
# later point this to Redis without changing application code.
REDIS_URL=
CACHE_PREFIX=madhushala-bridge:v1
CACHE_MASTER_TTL_SECONDS=1800
CACHE_USER_TTL_SECONDS=900
CACHE_SCHEME_TTL_SECONDS=900
CACHE_TAX_TTL_SECONDS=10800
CACHE_ITEM_TTL_SECONDS=21600

# Purchase orchestration
PURCHASE_CALCULATION_REQUIRED=true
PURCHASE_DUPLICATE_CHECK_REQUIRED=false
PURCHASE_DEFAULT_SALES_TAX_RATE=0
PURCHASE_DEFAULT_SALES_TAX_INCLUDING_FREE=false

EXCISE_USERNAME=
EXCISE_PASSWORD=
EXCISE_LOGIN_URL=https://excise.wb.gov.in/WBSBCL/Bevco/NIC/UserLogin/Login.aspx

BROWSER_PROFILE_DIR=/app/data/browser_profile
CAPTURES_DIR=/app/data/captures
MAPPINGS_DIR=/app/data/mappings

CORS_ORIGINS=http://localhost:8091,http://127.0.0.1:8091,https://excise.connect.snapkey.in

DISPLAY=:99
VNC_GEOMETRY=1366x768x24
VNC_PORT=5900
NOVNC_PORT=6080
